# 🔨 Build
target/
build/
dist/
out/

# Maven wrapper
.mvn/wrapper/maven-wrapper.jar

# Permitir target/build dentro de src (como tenías)
!**/src/main/**/target/
!**/src/test/**/target/
!**/src/main/**/build/
!**/src/test/**/build/

